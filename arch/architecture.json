{
  "version": 1,
  "system": "archwhere",
  "kinds": [
    "core",
    "security",
    "feature",
    "infra",
    "product",
    "ops",
    "docs"
  ],
  "components": {
    "core": {
      "name": "Core mapper",
      "kind": "core",
      "description": "Model loading, glob mapping, renderers.",
      "paths": [
        "lib/where.js",
        "lib/infer.js",
        "lib/collide.js"
      ],
      "deps": []
    },
    "rail": {
      "name": "Rail & BYOA logic",
      "kind": "core",
      "description": "Attention-rail categorisation, why each item sits where it does, runtime signal grading, agent mention. Pure: no network, no fs.",
      "paths": [
        "lib/rail.js",
        "lib/signals.js"
      ],
      "deps": [
        "core",
        "merge-gate"
      ]
    },
    "record": {
      "name": "Attributed record",
      "kind": "core",
      "description": "Append-only hash-linked log: specs, decisions, findings, corrections, reviews, claims, owner sign-offs, independent-review check.",
      "paths": [
        "lib/record.js",
        "lib/record-cli.js",
        "lib/claims.js",
        "lib/signoff.js",
        "lib/review.js",
        "lib/component-view.js"
      ],
      "deps": [
        "core",
        "mission",
        "rail"
      ]
    },
    "mcp": {
      "name": "MCP server",
      "kind": "product",
      "description": "archwhere mcp: hand-written JSON-RPC over stdio. Read-only unless --write. No merge or shell tool.",
      "paths": [
        "lib/mcp.js"
      ],
      "deps": [
        "core",
        "rail",
        "record",
        "mission"
      ],
      "provider": "MCP over stdio"
    },
    "mission": {
      "name": "Mission control",
      "kind": "product",
      "description": "Local UI server + page, and the bridge that lets CLI agents answer board threads.",
      "paths": [
        "lib/mission.js",
        "lib/bridge.js",
        "lib/gh.js",
        "ui/**"
      ],
      "deps": [
        "core",
        "merge-gate",
        "rail",
        "record"
      ],
      "provider": "Node http · localhost"
    },
    "archify": {
      "name": "Archify compiler",
      "kind": "feature",
      "description": "Model → Archify IR.",
      "paths": [
        "lib/archify.js"
      ],
      "deps": [
        "core"
      ]
    },
    "integrations": {
      "name": "Action & listeners",
      "kind": "infra",
      "description": "GitHub Action, consumer workflow templates, agent skill.",
      "paths": [
        "action.yml",
        "templates/**",
        "SKILL.md"
      ],
      "deps": [],
      "provider": "GitHub Actions"
    },
    "examples": {
      "name": "Examples",
      "kind": "docs",
      "description": "Meridian fictional model.",
      "paths": [
        "examples/**"
      ],
      "deps": []
    },
    "ops": {
      "name": "Ops & tests",
      "kind": "ops",
      "description": "CI and the test suite.",
      "paths": [
        ".github/**",
        "test/**",
        "package.json",
        "package-lock.json",
        ".gitignore",
        ".gitattributes",
        "arch/**"
      ],
      "deps": []
    },
    "docs": {
      "name": "Docs",
      "kind": "docs",
      "description": "README, license, images.",
      "paths": [
        "*.md",
        "LICENSE",
        "docs/**"
      ],
      "deps": []
    },
    "merge-gate": {
      "name": "Merge & review gate",
      "kind": "security",
      "description": "What stands between an agent's PR and main: the live recheck before a merge, and the comparison that catches a PR weakening the map.",
      "paths": [
        "lib/guard.js",
        "lib/merge.js"
      ],
      "deps": [
        "core",
        "rail"
      ],
      "watch": [
        {
          "pattern": "mergeDecision|modelWeakenings|gateFailures|REVIEW_LABEL",
          "note": "changes what a merge or a PR check is allowed to skip: owner review"
        }
      ]
    },
    "cli": {
      "name": "CLI",
      "kind": "product",
      "description": "The archwhere command: dispatches to everything else.",
      "paths": [
        "bin/**"
      ],
      "deps": [
        "archify",
        "core",
        "mcp",
        "merge-gate",
        "mission",
        "rail",
        "record"
      ]
    }
  },
  "flows": {
    "pr-map": {
      "name": "PR gets mapped",
      "actor": "Any pull request",
      "steps": [
        {
          "from": "integrations",
          "to": "core",
          "label": "action runs the mapper"
        },
        {
          "from": "core",
          "to": "integrations",
          "label": "comment with highlighted map"
        }
      ]
    },
    "thread": {
      "name": "Thread to agent reply",
      "actor": "Operator on the map",
      "steps": [
        {
          "from": "mission",
          "to": "rail",
          "label": "new component thread"
        },
        {
          "from": "rail",
          "to": "integrations",
          "label": "issue + mention fires listener"
        },
        {
          "from": "integrations",
          "to": "mission",
          "label": "agent reply lands on the map"
        }
      ]
    },
    "ask-owner": {
      "name": "Agent asks the owner",
      "actor": "An agent on MCP",
      "steps": [
        {
          "from": "mcp",
          "to": "mission",
          "label": "ask_human opens a needs-owner issue"
        },
        {
          "from": "mission",
          "to": "rail",
          "label": "shown under Blocked"
        },
        {
          "from": "mcp",
          "to": "record",
          "label": "the question is recorded with its author"
        }
      ]
    },
    "claim-review-signoff": {
      "name": "Claim, review, sign off",
      "actor": "Agents and the owner",
      "steps": [
        {
          "from": "mcp",
          "to": "record",
          "label": "agent claims a task under the lock"
        },
        {
          "from": "record",
          "to": "mcp",
          "label": "a second claimant is refused"
        },
        {
          "from": "mcp",
          "to": "record",
          "label": "another vendor records a review"
        },
        {
          "from": "core",
          "to": "record",
          "label": "owner signs off from the CLI, never over MCP"
        }
      ]
    },
    "merge": {
      "name": "Owner merges a PR",
      "actor": "Owner at mission control",
      "steps": [
        {
          "from": "mission",
          "to": "merge-gate",
          "label": "Merge clicked, with the commit shown"
        },
        {
          "from": "merge-gate",
          "to": "rail",
          "label": "assess the live PR"
        },
        {
          "from": "merge-gate",
          "to": "mission",
          "label": "merged at that commit, or why not"
        }
      ]
    }
  }
}
